<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Registers this app's map with Volition at process start. Not exported: the component adb calls is
            Volition's own, which arrives with the debugImplementation artifact.
        -->
        <provider
            android:name="eu.kanade.tachiyomi.debug.bridge.KomikkuVolitionProvider"
            android:authorities="${applicationId}.volition.map"
            android:exported="false" />

    </application>

</manifest>
